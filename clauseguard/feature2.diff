+function renderInvestigation() {
+    if (!investigationData) return;
+    
+    const inv = investigationData;
+    const contract = inv.contract || {};
+    const findings = inv.findings || [];
+    const focusFinding = inv.focus_finding || (findings[0] || {});
+    const evidence = inv.evidence || [];
+    const signals = inv.signals || [];
+    const whyItMatters = inv.explanation || "";
+    const relatedClauses = inv.related_clauses || [];
+    const consequence = inv.consequence || "";
+    const reviewPoints = inv.review_points || [];
+    const stats = inv.stats || { signals: signals.length, related: relatedClauses.length, review: reviewPoints.length };
+    
+    // Update header
+    invEls.contractTitle.textContent = contract.title || "Contract Investigation";

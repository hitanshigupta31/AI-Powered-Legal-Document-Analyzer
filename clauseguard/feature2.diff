+    // ===== CONTRACT VISUAL =====
+    const clauseCount = contract.clause_count || findings.length;
+    const findingCount = findings.length;
+    invEls.contractTitleText.textContent = contract.title || "CONTRACT";
+    invEls.contractSubtitleText.textContent = `— ${clauseCount} clauses · ${findingCount} findings —`;
+    
+    // Draw contract lines

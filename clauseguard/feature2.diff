+def _find_related_clauses(target_clause: dict, all_clauses: list) -> list:
+    """Find clauses related to the target clause."""
+    target_type = target_clause.get("clause_type", "")
+    target_id = target_clause.get("clause_id")
+    
+    # Define relationships between clause types
+    relationships = {
+        "Termination": ["Intellectual Property", "Confidentiality", "Payment", "Indemnification"],
+        "Intellectual Property": ["Termination", "Confidentiality", "Payment"],
+        "Payment": ["Termination", "Intellectual Property", "Indemnification"],
+        "Indemnification": ["Termination", "Limitation of Liability", "Payment"],
+        "Confidentiality": ["Termination", "Intellectual Property", "Restrictive Covenant"],
+        "Restrictive Covenant": ["Termination", "Confidentiality", "Payment"],
+        "Limitation of Liability": ["Indemnification", "Termination"],
+        "Non-Compete": ["Termination", "Confidentiality"],
+    }
+    
+    related_types = relationships.get(target_clause.get("clause_type", ""), [])
+    related = []
+    
+    for clause in all_clauses:
+        if clause.get("clause_id") == target_clause.get("clause_id"):
+            continue
+        if clause.get("clause_type") in related_types:
+            relationship = _describe_relationship(target_clause.get("clause_type"), clause.get("clause_type"))
+            related.append({
+                "clause_id": str(clause.get("clause_id")),
+                "title": clause.get("title", ""),
+                "type": clause.get("clause_type"),
+                "relationship": relationship
+            })
+    
+    return related[:3]  # Limit to top 3 related clauses
+
+
+def _describe_relationship(type1: str, type2: str) -> str:
+    """Describe the relationship between two clause types."""
+    relationships = {
+        ("Termination", "Intellectual Property"): "Termination triggers IP ownership transfer",
+        ("Intellectual Property", "Termination"): "IP ownership survives termination",
+        ("Termination", "Confidentiality"): "Termination does not end confidentiality obligations",
+        ("Confidentiality", "Termination"): "Confidentiality survives termination",
+        ("Termination", "Payment"): "Termination triggers final payment obligation",
+        ("Payment", "Termination"): "Payment terms survive termination for work completed",
+        ("Termination", "Indemnification"): "Termination may trigger indemnification obligations",
+        ("Indemnification", "Termination"): "Indemnification survives termination",
+        ("Termination", "Payment"): "Termination triggers final payment",
+        ("Confidentiality", "Termination"): "Confidentiality survives termination",
+        ("Restrictive Covenant", "Termination"): "Restrictions activate on termination",
+        ("Termination", "Restrictive Covenant"): "Termination activates non-compete restrictions",
+    }
+    
+    key = (type1, type2)
+    return relationships.get(key, f"Related to {type2.lower()}")

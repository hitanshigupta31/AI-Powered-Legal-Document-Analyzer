+def _find_evidence_for_flag(clause_text: str, flag: str) -> str:
+    """Find relevant text in clause that supports a risk flag."""
+    flag_lower = flag.lower()
+    text_lower = clause_text.lower()
+    
+    # Map flags to search patterns
+    flag_patterns = {
+        "termination without meaningful notice": ["without notice", "without prior notice", "immediately"],
+        "broad termination right": ["at any time", "for any reason", "for no reason", "without cause", "sole discretion"],
+        "potentially one-sided termination": ["either party", "one party"],
+        "broad indemnification scope": ["any and all claims", "any and all", "all claims", "any claims"],
+        "defense and indemnity obligation": ["indemnify, defend, and hold harmless", "indemnify and hold harmless", "hold harmless"],
+        "potentially uncapped liability": ["unlimited", "not subject to any monetary cap", "without limitation", "no monetary cap"],
+        "legal-fee exposure": ["attorneys' fees", "attorney's fees", "legal fees"],
+        "automatic renewal": ["automatically renew", "automatic renewal", "successive", "renewal term"],
+        "extended non-renewal notice": ["90 days", "ninety days", "60 days", "sixty days", "120 days", "one hundred twenty days"],
+        "continuing fee obligation": ["remaining fees", "fees through the end", "full remaining term"],
+        "potentially unlimited liability": ["unlimited liability", "unlimited", "not subject to any monetary cap", "no monetary cap"],
+        "liability allocation provision": ["aggregate liability", "liability shall not exceed", "maximum liability"],
+        "broad intellectual-property assignment": ["assigns all right, title and interest", "all right, title and interest", "hereby assigns", "irrevocably assigns"],
+        "broad rights over pre-existing materials": ["pre-existing", "background intellectual property", "prior inventions"],
+        "long-lasting confidentiality obligation": ["perpetual", "at all times", "survive termination", "indefinitely"],
+        "broad confidential-information scope": ["trade secrets", "all confidential information", "non-public information"],
+        "non-compete restriction": ["non-compete", "non compete", "noncompetition", "competing business"],
+        "time-limited post-termination restriction": ["five years", "3 years", "three years", "two years", "one year", "months"],
+        "extended payment period": ["net 60", "net sixty", "net 90", "ninety days", "60 days"],
+        "one-sided payment discretion": ["sole discretion", "may withhold", "may deduct"],
+        "mandatory dispute-resolution mechanism": ["binding arbitration", "mandatory arbitration", "waive a trial by jury", "waive trial by jury"],
+    }
+    
+    # Find matching evidence text
+    patterns = flag_patterns.get(flag.lower(), [])
+    for pattern in patterns:
+        if pattern in clause_text.lower():
+            # Find the sentence containing this pattern
+            sentences = re.split(r'(?<=[.!?])\s+', clause_text)
+            for sent in sentences:
+                if pattern in sent.lower():
+                    return sent.strip()
+    
+    # Fallback: return first 200 chars of clause
+    return clause_text[:200] + ("..." if len(clause_text) > 200 else "")
+

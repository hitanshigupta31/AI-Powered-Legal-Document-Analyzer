+    consequence = _generate_consequence(focus_finding, all_clauses)
+    review_points = _generate_review_points(focus_finding, all_clauses)
+    
+    # Contract title
+    contract_title = filename.replace(".pdf", "").replace(".docx", "").replace("_", " ").title()
+    
+    # Stats
+    high_count = summary.get("high_risk_count", sum(1 for c in clauses if c.get("risk_level") == "HIGH"))
+    medium_count = summary.get("medium_risk_count", sum(1 for c in clauses if c.get("risk_level") == "MEDIUM"))
+    low_count = summary.get("low_risk_count", sum(1 for c in clauses if c.get("risk_level") == "LOW"))
+    
+    return {
+        "contract": {
+            "title": contract_title,
+            "filename": filename,
+            "contract_id": contract_id,
+            "clause_count": len(clauses),
+            "finding_count": len(findings),

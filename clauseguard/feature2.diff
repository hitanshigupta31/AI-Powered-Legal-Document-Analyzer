+def generate_contract_investigation(
+    contract_data: dict,
+    all_clauses: list
+) -> dict:
+    """
+    Generate a contract-level investigation for the entire contract.
+    
+    This creates a structured investigation that starts from the whole contract
+    and progressively focuses on the highest-risk finding.
+    
+    Args:
+        contract_data: Full contract data with clauses, summary, filename
+        all_clauses: All clauses in the contract
+        
+    Returns:
+        Structured investigation object for the scroll-driven UI
+    """
+    clauses = all_clauses
+    summary = contract_data.get("summary", {})
+    filename = contract_data.get("filename", "Uploaded Agreement")
+    contract_id = contract_data.get("contract_id")
+    
+    # Collect all findings (clauses with risk flags)
+    findings = []
+    for clause in clauses:
+        risk_flags = clause.get("risk_flags", [])
+        risk_reasons = clause.get("risk_reasons", [])
+        risk_level = clause.get("risk_level", "LOW")
+        risk_score = clause.get("risk_score", 0)
+        
+        if risk_flags or risk_level in ("HIGH", "MEDIUM"):
+            findings.append({
+                "clause_id": str(clause.get("clause_id")),
+                "title": clause.get("title", clause.get("clause_type", "Clause")),
+                "type": clause.get("clause_type", "Other"),
+                "risk_level": risk_level,
+                "risk_score": risk_score,
+                "risk_flags": risk_flags,
+                "risk_reasons": risk_reasons,
+                "clause_text": clause.get("text", "")
+            })
+    
+    # Sort findings by risk score (highest first)
+    findings.sort(key=lambda f: f.get("risk_score", 0), reverse=True)
+    
+    # Pick focus finding (highest risk)
+    focus_finding = findings[0] if findings else {}
+    
+    # Build evidence for focus finding
+    focus_clause = None
+    for clause in clauses:
+        if str(clause.get("clause_id")) == focus_finding.get("clause_id"):
+            focus_clause = clause
+            break
+    
+    if not focus_clause and clauses:
+        focus_clause = clauses[0]
+    
+    focus_text = focus_clause.get("text", "") if focus_clause else ""
+    focus_flags = focus_finding.get("risk_flags", [])
+    focus_reasons = focus_finding.get("risk_reasons", [])
+    
+    # Build evidence array
+    evidence = []
+    signals = []
+    for i, flag in enumerate(focus_flags):
+        reason = focus_reasons[i] if i < len(focus_reasons) else ""
+        evidence_text = _find_evidence_for_flag(focus_text, flag)
+        evidence.append({
+            "text": evidence_text,
+            "signal": flag
+        })
+        signals.append({
+            "flag": flag,
+            "reason": reason,
+            "evidence_text": evidence_text
+        })
+    
+    # Find related clauses for focus finding
+    related_clauses = _find_related_clauses(focus_finding, all_clauses)
+    
+    # Generate explanation, consequence, review points

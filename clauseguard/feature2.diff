+        const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
+        line.setAttribute("class", "inv-contract-line");
+        line.setAttribute("x1", "380");
+        line.setAttribute("y1", y);
+        line.setAttribute("x2", "620");
+        line.setAttribute("y2", y);
+        invEls.contractLines.appendChild(line);
+    }
+    
+    // ===== FINDINGS ENTERING =====
+    invEls.findingsGroup.innerHTML = "";
+    findings.forEach((finding, i) => {
+        const angle = (i / Math.max(findings.length, 1)) * 2 * Math.PI - Math.PI / 2;
+        const radius = 280 + (i % 3) * 40;
+        const cx = 500 + Math.cos(angle) * radius;
+        const cy = 500 + Math.sin(angle) * radius;
+        
+        const g = document.createElementNS("http://www.w3.org/2000/svg", "g");
+        g.setAttribute("class", "inv-finding-node");
+        g.setAttribute("transform", `translate(${cx}, ${cy})`);
+        g.style.transitionDelay = `${i * 0.15}s`;
+        
+        // Ring
+        const ring = document.createElementNS("http://www.w3.org/2000/svg", "circle");
+        ring.setAttribute("class", "inv-finding-ring");
+        ring.setAttribute("r", "28");
+        ring.setAttribute("cx", "0");
+        ring.setAttribute("cy", "0");
+        
+        // Dot
+        const dot = document.createElementNS("http://www.w3.org/2000/svg", "circle");
+        dot.setAttribute("class", "inv-finding-dot");
+        dot.setAttribute("cx", "0");
+        dot.setAttribute("cy", "0");
+        
+        // Label
+        const label = document.createElementNS("http://www.w3.org/2000/svg", "text");
+        label.setAttribute("class", "inv-finding-label");
+        label.setAttribute("x", "0");
+        label.setAttribute("y", "-38");
+        label.textContent = finding.title || `Finding ${i + 1}`;
+        
+        g.appendChild(ring);
+        g.appendChild(dot);
+        g.appendChild(label);
+        invEls.findingsGroup.appendChild(g);
+        
+        // Trigger visibility after a delay
+        setTimeout(() => {
+            g.classList.add("visible");
+            ring.classList.add("visible");
+            label.classList.add("visible");
+        }, 300 + i * 150);
+    });
+    
+    // ===== FOCUS FINDING =====
+    const riskLevel = (focusFinding.risk_level || "LOW").toUpperCase();
+    const riskScore = focusFinding.risk_score ?? 0;
+    const riskFlags = focusFinding.risk_flags || [];
+    
+    invEls.focusTitle.textContent = focusFinding.title || "Key Finding";
+    invEls.focusRisk.textContent = `${riskLevel} RISK`;
+    invEls.focusRisk.setAttribute("fill", riskLevel === "HIGH" ? "#a64a42" : riskLevel === "MEDIUM" ? "#a36d21" : "#476f69");
+    invEls.focusScore.textContent = `SCORE ${riskScore}`;
+    
+    // Flags
+    invEls.focusFlags.innerHTML = "";
+    riskFlags.forEach((flag, i) => {
+        const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
+        text.setAttribute("class", "inv-focus-flag");
+        text.setAttribute("x", "500");
+        text.setAttribute("y", 430 + i * 20);
+        text.textContent = `• ${flag}`;
+        invEls.focusFlags.appendChild(text);
+    });
+    
+    // ===== EVIDENCE =====
+    const clauseText = focusFinding.clause_text || focusFinding.text || "";
+    const evidenceTexts = evidence.map(e => e.text).filter(Boolean);
+    let highlightedText = escapeHtml(clauseText);
+    evidenceTexts.forEach(evText => {
+        const escapedEv = escapeHtml(evText);
+        if (highlightedText.includes(escapedEv)) {
+            highlightedText = highlightedText.replace(
+                escapedEv,
+                `<mark class="evidence-highlight">${escapedEv}</mark>`
+            );
+        }
+    });
+    invEls.evidencePanel.innerHTML = highlightedText || "<em>No clause text available.</em>";
+    
+    // ===== SIGNALS =====
+    if (signals.length > 0) {
+        invEls.signalLabel.textContent = signals[0].flag || "Signal";
+        invEls.signalSub.textContent = `${signals.length} signal${signals.length > 1 ? "s" : ""} detected`;
+        
+        // Orbit rings
+        invEls.signalOrbits.innerHTML = "";
+        signals.forEach((signal, i) => {
+            const ringSize = 140 + i * 70;
+            const ring = document.createElementNS("http://www.w3.org/2000/svg", "circle");
+            ring.setAttribute("class", "inv-signal-orbit-ring");
+            ring.setAttribute("cx", "500");
+            ring.setAttribute("cy", "500");
+            ring.setAttribute("r", ringSize / 2);
+            ring.style.transitionDelay = `${i * 0.1}s`;
+            invEls.signalOrbits.appendChild(ring);
+            setTimeout(() => ring.classList.add("visible"), 300 + i * 100);
+        });
+        
+        // Signal nodes
+        invEls.signalNodes.innerHTML = "";
+        invEls.signalOrbits.querySelectorAll(".inv-signal-orbit-ring").forEach((ring, ringIdx) => {
+            const r = parseFloat(ring.getAttribute("r"));
+            signals.forEach((signal, i) => {
+                if (i !== ringIdx) return;
+                const angle = (i / signals.length) * 2 * Math.PI - Math.PI / 2;
+                const nodeR = r + 35;
+                const cx = 500 + Math.cos(angle) * nodeR;
+                const cy = 500 + Math.sin(angle) * nodeR;
+                
+                const g = document.createElementNS("http://www.w3.org/2000/svg", "g");
+                g.setAttribute("class", "inv-signal-node");
+                g.setAttribute("transform", `translate(${cx}, ${cy})`);
+                g.style.transitionDelay = `${300 + ringIdx * 100 + i * 80}ms`;
+                
+                const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
+                circle.setAttribute("class", "inv-signal-node-circle");
+                circle.setAttribute("cx", "0");
+                circle.setAttribute("cy", "0");
+                circle.setAttribute("r", "24");
+                
+                const labelText = document.createElementNS("http://www.w3.org/2000/svg", "text");
+                labelText.setAttribute("class", "inv-signal-node-text");
+                labelText.setAttribute("x", "0");
+                labelText.setAttribute("y", "-4");
+                labelText.textContent = (signal.flag || "Signal").substring(0, 12);
+                
+                const subText = document.createElementNS("http://www.w3.org/2000/svg", "text");
+                subText.setAttribute("class", "inv-signal-node-sub");
+                subText.setAttribute("x", "0");
+                subText.setAttribute("y", "8");
+                subText.textContent = (signal.reason || "").substring(0, 18);
+                
+                g.appendChild(circle);
+                g.appendChild(labelText);
+                g.appendChild(subText);
+                invEls.signalNodes.appendChild(g);
+                
+                setTimeout(() => g.classList.add("visible"), 300 + ringIdx * 100 + i * 80);
+                
+                // Connector from center
+                const connector = document.createElementNS("http://www.w3.org/2000/svg", "path");
+                connector.setAttribute("class", "inv-signal-connector");
+                const pathData = `M 500 500 Q ${500 + Math.cos(angle) * (r/2)} ${500 + Math.sin(angle) * (r/2)} ${cx} ${cy}`;
+                connector.setAttribute("d", pathData);
+                connector.style.transitionDelay = `${400 + ringIdx * 100 + i * 80}ms`;
+                invEls.signalOrbits.appendChild(connector);
+                setTimeout(() => connector.classList.add("visible"), 400 + ringIdx * 100 + i * 80);
+            });
+        });
+    } else {
+        invEls.signalLabel.textContent = "No signals detected";
+        invEls.signalSub.textContent = "";
+    }
+    
+    // ===== WHY IT MATTERS =====
+    invEls.whyPanel.innerHTML = `
+        <span class="why-title">WHY IT MATTERS</span>
+        ${escapeHtml(whyItMatters || "No explanation provided.")}
+    `;
+    
+    // ===== RELATED CLAUSES =====
+    invEls.relatedCenterLabel.textContent = "CENTRAL";
+    invEls.relatedCenterTitle.textContent = focusFinding.title || "Key Finding";
+    
+    // Orbit rings
+    invEls.relatedOrbits.innerHTML = "";
+    const relatedRings = [180, 280, 380];
+    relatedClauses.forEach((rc, i) => {
+        const ringIdx = Math.min(i, relatedRings.length - 1);
+        const ring = document.createElementNS("http://www.w3.org/2000/svg", "circle");
+        ring.setAttribute("class", "inv-related-orbit-ring");
+        ring.setAttribute("cx", "500");
+        ring.setAttribute("cy", "500");
+        ring.setAttribute("r", relatedRings[ringIdx] / 2);
+        ring.style.transitionDelay = `${i * 0.1}s`;
+        invEls.relatedOrbits.appendChild(ring);
+        setTimeout(() => ring.classList.add("visible"), 300 + i * 100);
+    });
+    
+    // Related nodes
+    invEls.relatedNodes.innerHTML = "";
+    invEls.relatedConnectors.innerHTML = "";
+    relatedClauses.forEach((rc, i) => {
+        const ringIdx = Math.min(i, relatedRings.length - 1);
+        const r = relatedRings[ringIdx] / 2;
+        const angle = (i / relatedClauses.length) * 2 * Math.PI - Math.PI / 2;
+        const nodeR = r + 90;
+        const cx = 500 + Math.cos(angle) * nodeR;
+        const cy = 500 + Math.sin(angle) * nodeR;
+        
+        // Node background
+        const nodeW = 160;
+        const nodeH = 72;
+        const bg = document.createElementNS("http://www.w3.org/2000/svg", "rect");
+        bg.setAttribute("class", "inv-related-node-bg");
+        bg.setAttribute("x", cx - nodeW/2);
+        bg.setAttribute("y", cy - nodeH/2);
+        bg.setAttribute("width", nodeW);
+        bg.setAttribute("height", nodeH);
+        
+        const typeText = document.createElementNS("http://www.w3.org/2000/svg", "text");
+        typeText.setAttribute("class", "inv-related-node-type");
+        typeText.setAttribute("x", cx);
+        typeText.setAttribute("y", cy - 18);
+        typeText.textContent = rc.type || "Related";
+        
+        const titleText = document.createElementNS("http://www.w3.org/2000/svg", "text");
+        titleText.setAttribute("class", "inv-related-node-title");
+        titleText.setAttribute("x", cx);
+        titleText.setAttribute("y", cy + 2);
+        titleText.textContent = (rc.title || "Related Clause").substring(0, 20);
+        
+        const relText = document.createElementNS("http://www.w3.org/2000/svg", "text");
+        relText.setAttribute("class", "inv-related-node-rel");
+        relText.setAttribute("x", cx);
+        relText.setAttribute("y", cy + 18);
+        relText.textContent = (rc.relationship || "Related").substring(0, 22);
+        
+        const g = document.createElementNS("http://www.w3.org/2000/svg", "g");
+        g.setAttribute("class", "inv-related-node");
+        g.style.transitionDelay = `${400 + i * 120}ms`;
+        g.appendChild(bg);
+        g.appendChild(typeText);
+        g.appendChild(titleText);
+        g.appendChild(relText);
+        invEls.relatedNodes.appendChild(g);
+        
+        setTimeout(() => g.classList.add("visible"), 400 + i * 120);
+        
+        // Connector from center
+        const connector = document.createElementNS("http://www.w3.org/2000/svg", "path");
+        connector.setAttribute("class", "inv-related-connector");
+        const ctrlX = 500 + Math.cos(angle) * (r + 30);
+        const ctrlY = 500 + Math.sin(angle) * (r + 30);
+        const pathData = `M 500 500 Q ${ctrlX} ${ctrlY} ${cx - Math.cos(angle) * (nodeW/2 + 5)} ${cy - Math.sin(angle) * (nodeH/2 + 5)}`;
+        connector.setAttribute("d", pathData);
+        connector.style.transitionDelay = `${500 + i * 120}ms`;
+        invEls.relatedConnectors.appendChild(connector);
+        
+        setTimeout(() => connector.classList.add("visible"), 500 + i * 120);
+    });
+    
+    // ===== CONSEQUENCE =====
+    invEls.consequencePanel.innerHTML = `
+        <span class="consequence-label">WHAT THIS MEANS</span>
+        <div class="consequence-text">${escapeHtml(consequence || "No consequence analysis provided.")}</div>
+    `;
+    
+    // ===== COMPLETE =====
+    invEls.completeStats.textContent = `Signals: ${stats.signals} · Related Clauses: ${stats.related} · Review Points: ${stats.review}`;
+    invEls.reviewPanel.innerHTML = `
+        <span class="review-title">WHAT TO REVIEW</span>
+        <ul>${reviewPoints.map(p => `<li>${escapeHtml(p)}</li>`).join("")}</ul>
+    `;
+    
+    // Reset step
+    currentStepIndex = 0;
+    updateStepProgress(0);
+}
+
+function setupInvestigationAnimations() {
+    // Check if GSAP is available
+    if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined") {
+        document.body.classList.add("no-gsap");
+        // Show all groups statically
+        [invEls.contractGroup, invEls.findingsGroup, invEls.focusGroup, 
+         invEls.evidenceGroup, invEls.signalGroup, invEls.whyGroup,
+         invEls.relatedGroup, invEls.consequenceGroup, invEls.completeGroup]
+            .forEach(g => g && (g.style.display = "block"));
+        return;
+    }
+    
+    // Register ScrollTrigger
+    gsap.registerPlugin(ScrollTrigger);
+    
+    // Kill any existing timeline
+    if (investigationTimeline) {
+        investigationTimeline.kill();
+    }
+    investigationScrollTriggers.forEach(st => st.kill());
+    investigationScrollTriggers = [];
+    
+    const canvas = invEls.canvas;
+    const stepCount = 8; // Contract, Findings, Focus, Evidence, Signal, Relations, Consequence, Complete
+    
+    // Create main timeline pinned to canvas
+    investigationTimeline = gsap.timeline({
+        scrollTrigger: {
+            trigger: canvas,
+            start: "top top",
+            end: "+=" + (stepCount * 500),
+            scrub: 1,
+            pin: true,
+            anticipatePin: 1,
+            onUpdate: self => {
+                const progress = self.progress;
+                const stepIndex = Math.min(Math.floor(progress * stepCount), stepCount - 1);
+                if (stepIndex !== currentStepIndex) {
+                    currentStepIndex = stepIndex;
+                    updateStepProgress(stepIndex);
+                    triggerStepAnimations(stepIndex);
+                }
+                
+                // Update timeline dot position
+                if (invEls.timelineDot) {
+                    const stepHeight = 500;
+                    const y = 50 + progress * (stepCount * stepHeight);
+                    gsap.set(invEls.timelineDot, { 
+                        cy: y,
+                        attr: { cy: y }
+                    });
+                }
+            }
+        }
+    });
+    
+    // Initial states
+    gsap.set([invEls.focusGroup, invEls.evidenceGroup, invEls.signalGroup, 
+              invEls.whyGroup, invEls.relatedGroup, invEls.consequenceGroup, invEls.completeGroup], 
+             { display: "none", opacity: 0 });
+    gsap.set(invEls.contractGroup, { opacity: 1 });
+    gsap.set(invEls.findingsGroup, { opacity: 1 });
+    gsap.set(invEls.timelineDot, { opacity: 1, cy: 50 });
+    
+    // Update progress marker position
+    updateStepProgress(0);
+}
+
+function triggerStepAnimations(stepIndex) {
+    if (prefersReducedMotion) return;
+    
+    switch (stepIndex) {
+        case 0: // Contract - initial state
+            gsap.to(invEls.contractGroup, { opacity: 1, duration: 0.5 });
+            gsap.to(invEls.findingsGroup, { opacity: 1, duration: 0.5 });
+            gsap.to([invEls.focusGroup, invEls.evidenceGroup, invEls.signalGroup, 
+                     invEls.whyGroup, invEls.relatedGroup, invEls.consequenceGroup, invEls.completeGroup], 
+                    { display: "none", opacity: 0, duration: 0.3 });
+            break;
+            
+        case 1: // Findings entering
+            gsap.to(invEls.contractGroup, { opacity: 0.6, duration: 0.5 });
+            gsap.to(invEls.findingsGroup, { opacity: 1, duration: 0.5 });
+            gsap.to([invEls.focusGroup, invEls.evidenceGroup, invEls.signalGroup, 
+                     invEls.whyGroup, invEls.relatedGroup, invEls.consequenceGroup, invEls.completeGroup], 
+                    { display: "none", opacity: 0, duration: 0.3 });
+            break;
+            
+        case 2: // Focus finding
+            gsap.to(invEls.contractGroup, { opacity: 0.3, duration: 0.5 });
+            gsap.to(invEls.findingsGroup, { opacity: 0.3, duration: 0.5 });
+            gsap.set(invEls.focusGroup, { display: "block" });
+            gsap.to(invEls.focusGroup, { opacity: 1, duration: 0.6, ease: "power2.out" });
+            gsap.to([invEls.evidenceGroup, invEls.signalGroup, invEls.whyGroup,
+                     invEls.relatedGroup, invEls.consequenceGroup, invEls.completeGroup], 
+                    { display: "none", opacity: 0, duration: 0.3 });
+            
+            // Animate focus base
+            gsap.from(invEls.focusBase, { 
+                scale: 0.9, 
+                opacity: 0, 
+                duration: 0.6, 
+                ease: "power2.out" 
+            });
+            break;
+            
+        case 3: // Evidence
+            gsap.set(invEls.evidenceGroup, { display: "block" });
+            gsap.to(invEls.evidenceGroup, { opacity: 1, duration: 0.5 });
+            gsap.to(invEls.focusGroup, { opacity: 0.5, duration: 0.3 });
+            
+            // Animate connector path drawing
+            if (invEls.connectorPath) {
+                const path = invEls.connectorPath;
+                const length = path.getTotalLength();
+                gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });
+                gsap.to(path, {
+                    strokeDashoffset: 0,
+                    duration: 1.2,
+                    ease: "power2.inOut"
+                });
+            }
+            break;
+            
+        case 4: // Signal
+            gsap.set(invEls.signalGroup, { display: "block" });
+            gsap.to(invEls.signalGroup, { opacity: 1, duration: 0.5 });
+            gsap.set(invEls.whyGroup, { display: "block" });
+            gsap.to(invEls.whyGroup, { opacity: 1, duration: 0.5, delay: 0.3 });
+            
+            // Animate signal center
+            gsap.from(invEls.signalCenter, { 
+                scale: 0.5, 
+                opacity: 0, 
+                duration: 0.6, 
+                ease: "back.out(1.7)" 
+            });
+            break;
+            
+        case 5: // Relations
+            gsap.set(invEls.relatedGroup, { display: "block" });
+            gsap.to(invEls.relatedGroup, { opacity: 1, duration: 0.6 });
+            gsap.to([invEls.signalGroup, invEls.whyGroup], { opacity: 0.4, duration: 0.3 });
+            
+            // Animate center node
+            gsap.from(invEls.relatedCenterNode.children, { 
+                scale: 0.5, 
+                opacity: 0, 
+                duration: 0.5, 
+                ease: "back.out(1.7)",
+                stagger: 0.1
+            });
+            break;
+            
+        case 6: // Consequence
+            gsap.set(invEls.consequenceGroup, { display: "block" });
+            gsap.to(invEls.consequenceGroup, { opacity: 1, duration: 0.6, ease: "power2.out" });
+            gsap.to(invEls.relatedGroup, { opacity: 0.3, duration: 0.3 });
+            
+            // Animate consequence panel
+            gsap.from(invEls.consequencePanel, { 
+                y: 30, 
+                opacity: 0, 
+                duration: 0.6, 
+                ease: "power2.out" 
+            });
+            break;
+            
+        case 7: // Complete
+            gsap.set(invEls.completeGroup, { display: "block" });
+            gsap.to(invEls.completeGroup, { opacity: 1, duration: 0.6, ease: "power2.out" });
+            gsap.to([invEls.consequenceGroup, invEls.relatedGroup, invEls.signalGroup], 
+                    { opacity: 0.2, duration: 0.3 });
+            break;
+    }
+}
+
+function updateStepProgress(stepIndex) {
+    // Update progress marker position
+    if (invEls.progressMarker && invEls.progressSteps.length > 0) {
+        const stepHeight = 54; // Approximate height per step
+        const top = stepIndex * stepHeight;
+        gsap.to(invEls.progressMarker, { 
+            top: top, 
+            duration: 0.8, 
+            ease: "power2.out" 
+        });
+    }
+    
+    // Update step labels
+    invEls.progressSteps.forEach((step, i) => {
+        step.classList.toggle("active", i === stepIndex);
+        step.classList.toggle("complete", i < stepIndex);
+    });
+}
+
+function cleanupInvestigationAnimations() {
+    if (investigationTimeline) {
+        investigationTimeline.kill();
+        investigationTimeline = null;
+    }
+    investigationScrollTriggers.forEach(st => st.kill());
+    investigationScrollTriggers = [];
+    
+    // Reset all groups
+    [invEls.contractGroup, invEls.findingsGroup, invEls.focusGroup, 
+     invEls.evidenceGroup, invEls.signalGroup, invEls.whyGroup,
+     invEls.relatedGroup, invEls.consequenceGroup, invEls.completeGroup]
+        .forEach(g => {
+            if (g) {
+                g.style.display = "";
+                gsap.set(g, { clearProps: "all" });
+            }
+        });
+    
+    // Reset SVG elements
+    if (invEls.connectorPath) {
+        gsap.set(invEls.connectorPath, { clearProps: "all" });
+    }
+    if (invEls.timelineDot) {
+        gsap.set(invEls.timelineDot, { clearProps: "all", opacity: 0 });
+    }
+    
+    currentStepIndex = 0;
+}
+
+function replayInvestigation() {
+    // Scroll back to top
+    window.scrollTo({ top: 0, behavior: "smooth" });
+    
+    // Reset animations
+    cleanupInvestigationAnimations();
+    
+    // Re-setup after a brief delay
+    setTimeout(() => {
+        setupInvestigationAnimations();
+        currentStepIndex = 0;
+        updateStepProgress(0);
+    }, 300);
+}
+
+// Update showView to include investigationView
+const originalShowView = showView;
+function showView(view) {
+    const viewIds = [
+        "uploadView",
+        "processingView",
+        "overviewView",
+        "groupView",
+        "askContractView",
+        "investigationView"
+    ];
+    
+    viewIds.forEach((viewId) => {
+        const element = document.getElementById(viewId);
+        if (element) {
+            element.classList.add("hidden");
+        }
+    });
+    
+    const targetView = typeof view === "string" ? document.getElementById(view) : view;
+    if (!targetView) {
+        console.error("showView: target view not found:", view);
+        return;
+    }
+    targetView.classList.remove("hidden");
+}
